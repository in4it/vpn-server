# Copy to provisioning/azure.env (gitignored) and fill in, used by
# provisioning/scripts/azure_marketplace_add_version.sh (make release-azure-marketplace).

# Microsoft Entra app added to Partner Center (Account settings > Users) with the Manager role
AZURE_PARTNER_TENANT_ID=
AZURE_PARTNER_CLIENT_ID=
AZURE_PARTNER_CLIENT_SECRET=
# Optional: offer ID(s) to update, comma separated (default: all VM offers of the account)
AZURE_OFFER_ID=
