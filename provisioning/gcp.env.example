# Copy to provisioning/gcp.env (gitignored) and fill in, used by
# provisioning/scripts/gcp_marketplace_release.sh (make release-gcp).

# Public project the Marketplace image is created in
GCP_PROJECT_ID=
# License from the Producer Portal deployment package:
# projects/<project>/global/licenses/cloud-marketplace-<id>
GCP_MARKETPLACE_LICENSE=
# Zone for the packer build VM
GCP_ZONE=us-east4-c
